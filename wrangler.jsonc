{
  "name": "noworriesfix-site",
  "compatibility_date": "2026-11-11",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "previews": {},
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "noworriesfix.com", "custom_domain": true },
    { "pattern": "www.noworriesfix.com", "custom_domain": true }
  ]
}
